record(stringin, "$(P):$(R):InputAddress") {
    field(DESC, "Address del comando da eseguire")
}


record(stringout, "$(P):$(R):setPollingPeriod") {
    field(DESC, "Polling period for all chain")
    field(DTYP, "OCEME642")
    field(OUT,  "@$(ADDR) setPollingPeriod")
    field(VAL,  "0.5")
   
}

record(ai, "$(P):$(R):IMAX") {
    field(DESC, "Max current for this channel")
    field(DTYP, "Soft Channel")
    field(VAL, "$(IMAX)")
    field(PREC, "1")
    field(EGU, "A")
    field(SCAN, "Passive")
    field(FLNK, "")      # opzionale
}
record(ai, "$(P):$(R):VMAX") {
    field(DESC, "Max Voltage for this channel")
    field(DTYP, "Soft Channel")
    field(VAL, "$(VMAX)")
    field(PREC, "1")
    field(EGU, "A")
    field(SCAN, "Passive")
    field(FLNK, "")      # opzionale
}



# CurrentNum kept for backward compatibility / debugging
record(ai, "$(P):$(R):CurrentNum") {
    field(DTYP, "Soft Channel")
    field(INP, "$(P):$(R):CurrentStr NPP NMS")
    field(SCAN, "Passive")
}

record(calc, "$(P):$(R):VOLTAGE_RB") {
    field(INPA, "$(P):$(R):VoltageStr NPP NMS")     # valore numerico grezzo
    field(INPB, "$(P):$(R):VMAX NPP NMS")           # valore massimo
    field(INPC, "$(P):$(R):VOLTAGE_PRG_MAX NPP NMS")    # fattore di scala
    field(CALC, "C>0?(A*B)/C:0")                    # protect against div by 0
    field(PREC, "4")                                # 4 decimali di precisione
    field(SCAN, "Passive")                         # si aggiorna automaticamente
    field(EGU,  "V")                                # unità di misura
}



record(stringin, "$(P):$(R):Status") {
    field(DESC, "Legge lo stato")
    field(DTYP, "OCEME642")
    field(INP,  "@$(ADDR) STA")
    field(SCAN, "I/O Intr")
}
record(stringin, "$(P):$(R):CurrentStr") {
    field(DESC, "Legge la corrente")
    field(DTYP, "OCEME642")
    field(INP,  "@$(ADDR) COR")
    field(SCAN, "I/O Intr")
    field(FLNK, "$(P):$(R):CurrentNum")
}

record(stringin, "$(P):$(R):VoltageStr") {
    field(DESC, "Legge la tensione")
    field(DTYP, "OCEME642")
    field(INP,  "@$(ADDR) TEN")
    field(SCAN, "I/O Intr")
    field(FLNK, "$(P):$(R):VOLTAGE_RB")
}

record(stringin, "$(P):$(R):Polarity") {
    field(DESC, "Legge la polarità")
    field(DTYP, "OCEME642")
    field(INP,  "@$(ADDR) POL")
    field(SCAN, "I/O Intr")
    
}
# Integer polarity value for calc records: +1=POS, -1=NEG, 0=OPN
record(longin, "$(P):$(R):IntPolarity") {
    field(DESC, "Numeric polarity value")
    field(DTYP, "OCEME642")
    field(INP,  "@$(ADDR) INTPOLA")
    field(SCAN, "I/O Intr")
    
}




record(stringin, "$(P):$(R):Alarms") {
    field(DESC, "Legge gli allarmi")
    field(DTYP, "OCEME642")
    field(INP,  "@$(ADDR) ALL")
    field(SCAN, "I/O Intr")
}

# Raw alarm presence indicator (0=OK, 1=Alarm active)
record(longin, "$(P):$(R):HAS_ALARM_RAW") {
    field(DESC, "Alarm present raw")
    field(DTYP, "OCEME642")
    field(INP,  "@$(ADDR) HAS_ALARM")
    field(SCAN, "I/O Intr")
    field(FLNK, "$(P):$(R):HAS_ALARM")
}

# Alarm status (binary indicator)
record(bi, "$(P):$(R):HAS_ALARM") {
    field(DESC, "Alarm present indicator")
    field(INP,  "$(P):$(R):HAS_ALARM_RAW NPP NMS")
    field(SCAN, "Passive")
    field(ZNAM, "OK")
    field(ONAM, "ALARM")
    field(ZSV,  "NO_ALARM")
    field(OSV,  "MAJOR")
}

# Alarm bitmask (32-bit): bit N = alarm N+1 active
record(longin, "$(P):$(R):ALARM_MASK") {
    field(DESC, "Alarm bitmask")
    field(DTYP, "OCEME642")
    field(INP,  "@$(ADDR) ALARM_MASK")
    field(SCAN, "I/O Intr")
}

record(stringin, "$(P):$(R):SELECTOR") {
    field(DESC, " LOCAL or REMOTE")
    field(DTYP, "OCEME642")
    field(INP,  "@$(ADDR) SEL")    # indirizzo + eventuale parametro
    field(SCAN, "I/O Intr")
}

record(stringin, "$(P):$(R):VERSION") {
    field(DESC, "PS firmware version")
    field(DTYP, "OCEME642")
    field(INP,  "@$(ADDR) VER")
    field(SCAN, "I/O Intr")
}

record(stringin, "$(P):$(R):CURRENT_PRG_MAX") {
    field(DESC, " Max Current set digit")
    field(DTYP, "OCEME642")
    field(INP,  "@$(ADDR) INI_CURMAX")    # indirizzo + eventuale parametro
    field(SCAN, "I/O Intr")
}
record(stringin, "$(P):$(R):CURRENT_PRG_MIN") {
    field(DESC, " Min Current set digit")
    field(DTYP, "OCEME642")
    field(INP,  "@$(ADDR) INI_CURMIN")    # indirizzo + eventuale parametro
    field(SCAN, "I/O Intr")
}
record(stringin, "$(P):$(R):VOLTAGE_PRG_MAX") {
    field(DESC, " Max Voltage set digit")
    field(DTYP, "OCEME642")
    field(INP,  "@$(ADDR) INI_VOLMAX")    # indirizzo + eventuale parametro
    field(SCAN, "I/O Intr")
}
record(stringin, "$(P):$(R):VOLTAGE_PRG_MIN") {
    field(DESC, " Min Voltage set digit")
    field(DTYP, "OCEME642")
    field(INP,  "@$(ADDR) INI_VOLMIN")    # indirizzo + eventuale parametro
    field(SCAN, "I/O Intr")
}

record(stringin, "$(P):$(R):UNIMAGSTATUS") {
    field(DESC, " Status converted to unimag standard")
    field(DTYP, "OCEME642")
    field(INP,  "@$(ADDR) UNIMAG")    # indirizzo + eventuale parametro
    field(SCAN, "I/O Intr")
    field(FLNK, "$(P):$(R):STATE_RB")
}

record(mbbi, "$(P):$(R):STATE_RB") {
    field(DESC, "State readback")
    field(INP,  "$(P):$(R):UNIMAGSTATUS NPP NMS")
    field(SCAN, "Passive") 
    field(ZRVL, "0")
    field(ZRST, "OFF")
    field(ONVL, "1")
    field(ONST, "ON")
    field(TWVL, "2")
    field(TWST, "STANDBY")
    field(THVL, "3")
    field(THST, "RESET")
    field(FRVL, "4")
    field(FRST, "INTERLOCK")
    field(FRSV, "MAJOR") 
    field(FVVL, "5")
    field(FVST, "ERROR")
    field(FVSV, "MAJOR")
}


record(stringout, "$(P):$(R):SetON") {
    field(DTYP, "OCEME642")
    field(OUT,  "@$(ADDR) ON")    # indirizzo + eventuale parametro
    field(VAL,  "ON")        # valore di default
}
record(stringout, "$(P):$(R):SetSTANDBY") {
    field(DTYP, "OCEME642")
    field(OUT,  "@$(ADDR) STB")    # indirizzo + eventuale parametro
    field(VAL,  "STB")        # valore di default
}

record(stringout, "$(P):$(R):SetPolarity") {
    field(DESC, "values: \"POS\" , \"OPN\",\"NEG\"")
    field(DTYP, "OCEME642")
    field(OUT,  "@$(ADDR) setPOL")    # indirizzo + eventuale parametro
    
}
record(stringout, "$(P):$(R):STATUS_SP") {
    field(DESC, "Set Status, values: \"STB\" e \"ON\"")
    field(DTYP, "OCEME642")
    field(OUT,  "@$(ADDR) setSTA")    # indirizzo + eventuale parametro
    
}
record(stringout, "$(P):$(R):SETCURRENT_RAW") {
    field(DTYP, "OCEME642")
    field(OUT,  "@$(ADDR) SP")    # indirizzo + eventuale parametro
    #field(VAL,  "STB")        # valore di default
    field(OMSL, "closed_loop")             # prende valore da DOL
    field(DOL, "$(P):$(R):AmpToDigitFormat.VAL NPP NMS")
    
}

record(ao, "$(P):$(R):SETCURRENT") {
    field(DESC, "Set current in Ampere")
    field(EGU,  "A")
    field(PREC, "3")
    field(SCAN, "Passive")
    field(FLNK, "$(P):$(R):AmpToDigit")
}

record(calc, "$(P):$(R):AmpToDigit") {
    field(DESC, "Convert Ampere → Digit")
    field(INPA, "$(P):$(R):SETCURRENT NPP NMS")   # Ampere impostati
    field(INPB, "$(P):$(R):IMAX NPP NMS")         # Corrente massima
    field(INPC, "$(P):$(R):CURRENT_PRG_MAX NPP NMS")       # Program range massimo
    field(CALC, "A*C/B")                          # Digit = Ampere*IMAX/MAXPRG
    field(SCAN, "Passive")
    field(FLNK, "$(P):$(R):AmpToDigitFormat")
}

record(calcout, "$(P):$(R):AmpToDigitFormat") {
    field(INPA, "$(P):$(R):AmpToDigit.VAL NPP NMS")
    field(CALC, "NINT(A)")
    field(OUT,  "$(P):$(R):SETCURRENT_RAW.VAL PP")
    field(SCAN, "Passive")
}

record(stringout, "$(P):$(R):Start_ramp") {
    field(DTYP, "OCEME642")
    field(OUT,  "@$(ADDR) STR")    # indirizzo + eventuale parametro
    field(VAL,  "STR")        # valore di default
}
record(stringout, "$(P):$(R):RESET_ALARMS") {
    field(DTYP, "OCEME642")
    field(OUT,  "@$(ADDR) RES")    # indirizzo + eventuale parametro
    field(VAL,  "RES")        # valore di default
}
record(stringout, "$(P):$(R):PROGRAMDATA_RB") {
    field(DTYP, "OCEME642")
    field(OUT,  "@$(ADDR) PRG")    # indirizzo + eventuale parametro
    field(VAL,  "PRG S")        # valore di default
}

# Old raw current set command (deprecated - use CURRENT_SP instead)
record(stringout, "$(P):$(R):SETCURRENT_RAW_SETI") {
    field(DTYP, "OCEME642")
    field(OUT,  "@$(ADDR) SETI")
    field(FLNK, "$(P):$(R):IMAX")
}

# Helper record to read VMAX into driver (mirrors IMAX reading pattern)
record(stringout, "$(P):$(R):SETVOLTAGE_RAW_SETV") {
    field(DTYP, "OCEME642")
    field(OUT,  "@$(ADDR) SETV")
    field(FLNK, "$(P):$(R):VMAX")
}


record(stringout, "$(P):$(R):setRMT") {
    field(DTYP, "OCEME642")
    field(OUT,  "@$(ADDR) RMT")    # indirizzo + eventuale parametro
    field(VAL,  "RMT")        # valore di default
}
# ============================================
# Command State Machine Records
# ============================================

# Raw command state value from driver
record(stringin, "$(P):$(R):CMD_STATE_RAW") {
    field(DESC, "Raw command state value")
    field(DTYP, "OCEME642")
    field(INP,  "@$(ADDR) CMDSTATE")
    field(SCAN, "I/O Intr")
    field(FLNK, "$(P):$(R):CMD_STATE")
}

# Enumerated command state (mbbi)
record(mbbi, "$(P):$(R):CMD_STATE") {
    field(DESC, "Command state machine")
    field(INP,  "$(P):$(R):CMD_STATE_RAW NPP NMS")
    field(SCAN, "Passive")
    field(ZRVL, "0")
    field(ZRST, "IDLE")
    field(ZRSV, "NO_ALARM")
    field(ONVL, "1")
    field(ONST, "SENDING")
    field(ONSV, "NO_ALARM")
    field(TWVL, "2")
    field(TWST, "WAIT_ACK")
    field(TWSV, "NO_ALARM")
    field(THVL, "3")
    field(THST, "VERIFYING")
    field(THSV, "MINOR")
    field(FRVL, "4")
    field(FRST, "DONE")
    field(FRSV, "NO_ALARM")
    field(FVVL, "5")
    field(FVST, "NOT_REACHED")
    field(FVSV, "MAJOR")
}

# Human-readable command status message
record(stringin, "$(P):$(R):CMD_STATUS") {
    field(DESC, "Command status message")
    field(DTYP, "OCEME642")
    field(INP,  "@$(ADDR) CMDSTATUS")
    field(SCAN, "I/O Intr")
}

# Last command that was sent
record(stringin, "$(P):$(R):LAST_CMD") {
    field(DESC, "Last command sent")
    field(DTYP, "OCEME642")
    field(INP,  "@$(ADDR) LASTCMD")
    field(SCAN, "I/O Intr")
}

# ============================================
# UNIMAG State Machine Records
# ============================================

# ------------------------------------
# Current Setpoint (Amperes) - Main Interface
# ------------------------------------
record(ao, "$(P):$(R):CURRENT_SP") {
    field(DESC, "Current setpoint in Amperes")
    field(DTYP, "OCEME642")
    field(OUT,  "@$(ADDR) UNIMAG_CURRENT_SP")
    field(EGU,  "A")
    field(PREC, "4")
    field(DRVH, "$(IMAX)")
    field(DRVL, "-$(IMAX)")
    field(HOPR, "$(IMAX)")
    field(LOPR, "-$(IMAX)")
}
alias("$(P):$(R):CURRENT_SP", "$(P):$(R):SET_COMPLETE_CURRENT")

# ------------------------------------
# State Setpoint (ON, STANDBY, RESET) - Main Interface
# ------------------------------------
record(mbbo, "$(P):$(R):STATE_SP") {
    field(DESC, "State setpoint")
    field(DTYP, "Raw Soft Channel")
    field(ZRVL, "0")
    field(ZRST, "OFF")
    field(ONVL, "1")
    field(ONST, "ON")
    field(TWVL, "2")
    field(TWST, "STANDBY")
    field(THVL, "3")
    field(THST, "RESET")
    field(FRVL, "4")
    field(FRST, "INTERLOCK")
    field(FVVL, "5")
    field(FVST, "ERROR")
    field(FLNK, "$(P):$(R):state_router")
}

# State routing - ON command
record(calcout, "$(P):$(R):state_router") {
    field(DESC, "Route ON command")
    field(INPA, "$(P):$(R):STATE_SP")
    field(CALC, "A=1")
    field(OCAL, "1")
    field(OOPT, "When Non-zero")
    field(OUT,  "$(P):$(R):SetON.PROC PP")
    field(FLNK, "$(P):$(R):state_router1")
}

# State routing - STANDBY command
record(calcout, "$(P):$(R):state_router1") {
    field(DESC, "Route STB command")
    field(INPA, "$(P):$(R):STATE_SP")
    field(CALC, "A=2")
    field(OOPT, "When Non-zero")
    field(OUT,  "$(P):$(R):SetSTANDBY.PROC PP")
    field(FLNK, "$(P):$(R):state_router2")
}

# State routing - RESET command
record(calcout, "$(P):$(R):state_router2") {
    field(DESC, "Route RST command")
    field(INPA, "$(P):$(R):STATE_SP")
    field(CALC, "A=3")
    field(OOPT, "When Non-zero")
    field(OUT,  "$(P):$(R):RESET_ALARMS.PROC PP")
}

# State setpoint command forwarder (for driver state machine)
record(longout, "$(P):$(R):STATE_SP_OUT") {
    field(DESC, "Send state setpoint to driver")
    field(DTYP, "OCEME642")
    field(OUT,  "@$(ADDR) UNIMAG_STATE_SP")
    field(OMSL, "closed_loop")
    field(DOL,  "$(P):$(R):STATE_SP NPP")
}

# ------------------------------------
# State Machine Status (internal state machine state)
# ------------------------------------

# Raw state value from driver
record(longin, "$(P):$(R):SM_STATE_RAW") {
    field(DESC, "State machine raw value")
    field(DTYP, "OCEME642")
    field(INP,  "@$(ADDR) UNIMAG_STATE")
    field(SCAN, "I/O Intr")
    field(FLNK, "$(P):$(R):SM_STATE_RB")
}

# Enumerated state machine state
# Values match UnimagState enum: INIT=0, OK=1, NOT_REACHED=2, ZERO_STBY=3, CHANGE_POL=4, WAIT_POL=5, GOING_TO_SET=6
record(mbbi, "$(P):$(R):SM_STATE_RB") {
    field(DESC, "State machine status")
    field(INP,  "$(P):$(R):SM_STATE_RAW NPP NMS")
    field(SCAN, "Passive")
    field(ZRVL, "0")
    field(ZRST, "INIT")
    field(ZRSV, "NO_ALARM")
    field(ONVL, "1")
    field(ONST, "OK")
    field(ONSV, "NO_ALARM")
    field(TWVL, "2")
    field(TWST, "NOT_REACHED")
    field(TWSV, "MAJOR")
    field(THVL, "3")
    field(THST, "ZERO_STBY")
    field(THSV, "NO_ALARM")
    field(FRVL, "4")
    field(FRST, "CHANGE_POL")
    field(FRSV, "NO_ALARM")
    field(FVVL, "5")
    field(FVST, "WAIT_POL")
    field(FVSV, "NO_ALARM")
    field(SXVL, "6")
    field(SXST, "GOING_TO_SET")
    field(SXSV, "NO_ALARM")
}

# (CHANNEL_STATE removed - use STATE_RB instead)

# Busy indicator
record(longin, "$(P):$(R):BUSY_RAW") {
    field(DESC, "Busy raw")
    field(DTYP, "OCEME642")
    field(INP,  "@$(ADDR) UNIMAG_BUSY")
    field(SCAN, "I/O Intr")
    field(FLNK, "$(P):$(R):BUSY_RB")
}

record(bi, "$(P):$(R):BUSY_RB") {
    field(DESC, "Busy indicator")
    field(INP,  "$(P):$(R):BUSY_RAW NPP NMS")
    field(SCAN, "Passive")
    field(ZNAM, "Idle")
    field(ONAM, "Busy")
    field(ZSV,  "NO_ALARM")
    field(OSV,  "MINOR")
}

# Status message
record(stringin, "$(P):$(R):STATUS_MSG") {
    field(DESC, "Status message")
    field(DTYP, "OCEME642")
    field(INP,  "@$(ADDR) UNIMAG_STATUS")
    field(SCAN, "I/O Intr")
}

# Current readback (in Amperes) - Main Interface
record(ai, "$(P):$(R):CURRENT_RB") {
    field(DESC, "Current readback in Amperes")
    field(DTYP, "OCEME642")
    field(INP,  "@$(ADDR) CURRENT_RB_A")
    field(SCAN, "I/O Intr")
    field(EGU,  "A")
    field(PREC, "4")
}

# Current setpoint readback (in Amperes)
record(ai, "$(P):$(R):CURRENT_SP_RB") {
    field(DESC, "Current setpoint readback")
    field(DTYP, "OCEME642")
    field(INP,  "@$(ADDR) CURRENT_SP_A")
    field(SCAN, "I/O Intr")
    field(EGU,  "A")
    field(PREC, "4")
}

# Retry count
record(longin, "$(P):$(R):RETRY_COUNT") {
    field(DESC, "Current retry count")
    field(DTYP, "OCEME642")
    field(INP,  "@$(ADDR) RETRY_COUNT")
    field(SCAN, "I/O Intr")
}

# ------------------------------------
# UNIMAG Configuration Parameters
# ------------------------------------
# Macro defaults:
#   SET_TOLERANCE=1      - Allowed tolerance on CURRENT_RB when checking if requested current reached
#   ZERO_TOLERANCE=1     - Allowed tolerance when checking that current is zero
#   SET_TIMEOUT_S=10     - Timeout (seconds) to verify requested current reached
#   INIT_TIMEOUT_S=60    - Timeout (seconds) before retrying PRG initialization
#
# NOTE: Retry logic has been removed to simplify operation.
# If timeout occurs, operation fails immediately. Retries were masking
# underlying communication issues on the RS485 bus.

# Set tolerance (Amperes) - Allowed tolerance on CURRENT_RB when checking if requested current reached
record(ao, "$(P):$(R):set_tolerance") {
    field(DESC, "Setpoint tolerance")
    field(DTYP, "OCEME642")
    field(OUT,  "@$(ADDR) SET_TOL")
    field(EGU,  "A")
    field(PREC, "3")
    field(VAL,  "$(SET_TOLERANCE=1)")
    field(DRVL, "0")
    field(DRVH, "100")
    field(HOPR, "100")
    field(LOPR, "0")
    field(PINI, "YES")
}

# Zero tolerance (Amperes) - Allowed tolerance when checking that current is zero
record(ao, "$(P):$(R):zero_tolerance") {
    field(DESC, "Zero current tolerance")
    field(DTYP, "OCEME642")
    field(OUT,  "@$(ADDR) ZERO_TOL")
    field(EGU,  "A")
    field(PREC, "3")
    field(VAL,  "$(ZERO_TOLERANCE=1)")
    field(DRVL, "0")
    field(DRVH, "100")
    field(HOPR, "100")
    field(LOPR, "0")
    field(PINI, "YES")
}

# Setpoint timeout (seconds) - Timeout to verify requested current reached
record(ao, "$(P):$(R):set_timeout_s") {
    field(DESC, "Setpoint timeout")
    field(DTYP, "OCEME642")
    field(OUT,  "@$(ADDR) SET_TIMEOUT")
    field(EGU,  "s")
    field(PREC, "1")
    field(VAL,  "$(SET_TIMEOUT_S=10)")
    field(DRVL, "1")
    field(DRVH, "300")
    field(HOPR, "300")
    field(LOPR, "1")
    field(PINI, "YES")
}

# Init timeout (seconds) - Timeout before retrying PRG initialization
record(ao, "$(P):$(R):init_timeout_s") {
    field(DESC, "Init timeout before retry")
    field(DTYP, "OCEME642")
    field(OUT,  "@$(ADDR) INIT_TIMEOUT")
    field(EGU,  "s")
    field(PREC, "1")
    field(VAL,  "$(INIT_TIMEOUT_S=60)")
    field(DRVL, "10")
    field(DRVH, "600")
    field(HOPR, "600")
    field(LOPR, "10")
    field(PINI, "YES")
}

# ------------------------------------
# PRG Data Readbacks (detailed initialization info)
# ------------------------------------

# PRG Initialized flag (1 = initialized, 0 = waiting)
record(longin, "$(P):$(R):PRG:initialized") {
    field(DESC, "PRG init status")
    field(DTYP, "OCEME642")
    field(INP,  "@$(ADDR) PRG_INIT")
    field(SCAN, "I/O Intr")
    field(EGU,  "")
    field(HIGH, "0")
    field(HSV,  "MINOR")
}

# Current range max (raw DAC value)
record(longin, "$(P):$(R):PRG:current_max") {
    field(DESC, "Current range max (raw)")
    field(DTYP, "OCEME642")
    field(INP,  "@$(ADDR) INI_CURMAX")
    field(SCAN, "I/O Intr")
    field(EGU,  "counts")
}

# Current range min (raw DAC value)
record(longin, "$(P):$(R):PRG:current_min") {
    field(DESC, "Current range min (raw)")
    field(DTYP, "OCEME642")
    field(INP,  "@$(ADDR) INI_CURMIN")
    field(SCAN, "I/O Intr")
    field(EGU,  "counts")
}

# Voltage range max (raw DAC value)
record(longin, "$(P):$(R):PRG:voltage_max") {
    field(DESC, "Voltage range max (raw)")
    field(DTYP, "OCEME642")
    field(INP,  "@$(ADDR) INI_VOLMAX")
    field(SCAN, "I/O Intr")
    field(EGU,  "counts")
}

# Voltage range min (raw DAC value)
record(longin, "$(P):$(R):PRG:voltage_min") {
    field(DESC, "Voltage range min (raw)")
    field(DTYP, "OCEME642")
    field(INP,  "@$(ADDR) INI_VOLMIN")
    field(SCAN, "I/O Intr")
    field(EGU,  "counts")
}

# IMAX parameter (Amperes)
record(ai, "$(P):$(R):PRG:imax") {
    field(DESC, "Max current setting")
    field(DTYP, "OCEME642")
    field(INP,  "@$(ADDR) IMAX_RB")
    field(SCAN, "I/O Intr")
    field(EGU,  "A")
    field(PREC, "1")
}

# VMAX parameter (Volts)
record(ai, "$(P):$(R):PRG:vmax") {
    field(DESC, "Max voltage setting")
    field(DTYP, "OCEME642")
    field(INP,  "@$(ADDR) VMAX_RB")
    field(SCAN, "I/O Intr")
    field(EGU,  "V")
    field(PREC, "1")
}

# ============================================
# Unsolicited Message Thresholds (TH command)
# Controls when PS sends spontaneous COR/TEN messages
# Default: 5% of IMAX/VMAX
# ============================================

# Current threshold (Amperes)
# PS sends COR message when current changes by more than this value
record(ao, "$(P):$(R):THRESHOLD:current") {
    field(DESC, "Current msg threshold")
    field(DTYP, "OCEME642")
    field(OUT,  "@$(ADDR) CURRENT_TH")
    field(EGU,  "A")
    field(PREC, "3")
    field(VAL,  "$(CURRENT_THRESHOLD=-1)")
    field(DRVL, "0")
    field(DRVH, "$(IMAX)")
    field(HOPR, "$(IMAX)")
    field(LOPR, "0")
    field(PINI, "YES")
}

# Voltage threshold (Volts)
# PS sends TEN message when voltage changes by more than this value
record(ao, "$(P):$(R):THRESHOLD:voltage") {
    field(DESC, "Voltage msg threshold")
    field(DTYP, "OCEME642")
    field(OUT,  "@$(ADDR) VOLTAGE_TH")
    field(EGU,  "V")
    field(PREC, "3")
    field(VAL,  "$(VOLTAGE_THRESHOLD=-1)")
    field(DRVL, "0")
    field(DRVH, "$(VMAX)")
    field(HOPR, "$(VMAX)")
    field(LOPR, "0")
    field(PINI, "YES")
}

# ============================================
# Forced Query Configuration
# ============================================
# When FIFO is empty, periodically send SL/SA commands to refresh state
# 0 = disabled, otherwise interval in seconds (default 60)

# Forced state (SL) query interval
# Forces dump of status (STA, POL, ALL, SEL, VER)
record(ao, "$(P):$(R):FORCE_STATE_QUERY_S") {
    field(DESC, "Forced SL query interval")
    field(DTYP, "OCEME642")
    field(OUT,  "@$(ADDR) FORCE_STATE_QUERY_S")
    field(EGU,  "s")
    field(PREC, "0")
    field(VAL,  "$(FORCE_STATE_QUERY_S=60)")
    field(DRVL, "0")
    field(DRVH, "3600")
    field(HOPR, "3600")
    field(LOPR, "0")
    field(PINI, "YES")
}

# Forced operating (SA) query interval
# Forces dump of operating data (COR, TEN)
record(ao, "$(P):$(R):FORCE_OPERATING_QUERY_S") {
    field(DESC, "Forced SA query interval")
    field(DTYP, "OCEME642")
    field(OUT,  "@$(ADDR) FORCE_OPERATING_QUERY_S")
    field(EGU,  "s")
    field(PREC, "0")
    field(VAL,  "$(FORCE_OPERATING_QUERY_S=60)")
    field(DRVL, "0")
    field(DRVH, "3600")
    field(HOPR, "3600")
    field(LOPR, "0")
    field(PINI, "YES")
}